{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/lint-file.cjs",
            "timeout": 30,
            "statusMessage": "Linting edited file..."
          }
        ]
      }
    ]
  }
}
